{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usput-pulse",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "OSRM_URL": "https://routing.openstreetmap.de/routed-car/",
    "OSRM_FOOT_URL": "https://routing.openstreetmap.de/routed-foot/",
    "GEOCODER_URL": "https://nominatim.openstreetmap.org/",
    "GOOGLE_CLIENT_ID": "673712683395-pfegs6i0rk1chqqqol98hup5gekokkh4.apps.googleusercontent.com",
  },
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "usput-photos",
      "jurisdiction": "eu",
    },
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usput-db",
      "database_id": "72c9853b-fd62-4dc0-a393-e8408a4934bc",
      "migrations_dir": "server/migrations",
    },
  ],
}
